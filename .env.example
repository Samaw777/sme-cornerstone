# Copy this file to .env and fill it in. Never commit .env.

# Turn on for local development only.
DEBUG=1

# Shows the demo ribbon and demo sign-in hints. Defaults to DEBUG. Never enable with real data.
DEMO_MODE=1

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Postgres connection string (Supabase → Connect → "Session pooler").
# Leave empty to use a local SQLite file instead.
DATABASE_URL=

# Comma-separated hostnames the app is served from (Render's own hostname is added automatically).
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Defaults shown; change only if you need to.
TIME_ZONE=Africa/Addis_Ababa
PARTNER_API_RATE_LIMIT=60
PARTNER_API_AUTH_FAILURE_LIMIT=20
SUPPORT_ACCESS_MINUTES=30
DOCUMENT_MAX_BYTES=5242880
CSV_IMPORT_MAX_BYTES=1048576

# Optional SMTP for password reset emails. Without EMAIL_HOST, emails are printed to the server log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=SME Cornerstone <no-reply@example.com>
